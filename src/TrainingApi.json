  "components": {
    "schemas": {
      "Client": {
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "weight",
          "height",
          "birthDate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The unique identifier of the client, assigned by the system when the client is created",
            "format": "int32"
          },
          "firstName": {
            "maxLength": 50,
            "pattern": "^[a-zA-Z]+$",
            "type": "string",
            "description": "The first name of the client"
          },
          "lastName": {
            "maxLength": 50,
            "pattern": "^[a-zA-Z]+$",
            "type": "string",
            "description": "The last name of the client"
          },
          "email": {
            "type": "string",
            "description": "The email of the client"
          },
          "weight": {
            "type": "integer",
            "description": "The weight of the client in pounds, rounded to the nearest pound.",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "description": "The height of the client in inches, rounded to the nearest inch.",
            "format": "int32"
          },
          "birthDate": {
            "type": "string",
            "description": "The date of birth of the client",
            "format": "date-time"
          }
        },
        "example": {
          "id": 1,
          "firstName": "Jane",
          "lastName": "Smith",
          "email": "jane.smith@email.com",
          "weight": 60,
          "height": 170,
          "birthDate": "1990-01-01T00:00:00.0000000+00:00"
        }
      },
      "Level": {
        "enum": [
          "Junior",
          "Senior",
          "Elite"
        ],
        "description": "The level of the trainer"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Trainer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The unique identifier of the trainer, assigned by the system when the trainer is created",
            "format": "int32"
          },
          "firstName": {
            "maxLength": 50,
            "pattern": "^[a-zA-Z]+$",
            "type": "string",
            "description": "The first name of the trainer"
          },
          "lastName": {
            "maxLength": 50,
            "pattern": "^[a-zA-Z]+$",
            "type": "string",
            "description": "The last name of the trainer"
          },
          "email": {
            "type": "string",
            "description": "The email address of the trainer"
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "isCertificationActive": {
            "type": "boolean",
            "description": "The certification status of the trainer"
          }
        },
        "example": {
          "id": 1,
          "firstName": "John",
          "lastName": "Doe",
          "email": "john.doe@email.com",
          "level": "Junior",
          "isCertificationActive": false
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  },
  "tags": [
