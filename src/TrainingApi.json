  "components": {
    "schemas": {
      "Client": {
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "weight",
          "height",
          "birthDate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The unique identifier of the client, assigned by the system when the client is created.",
            "format": "int32"
          },
          "firstName": {
            "type": "string",
            "description": "The first name of the client."
          },
          "lastName": {
            "type": "string",
            "description": "The last name of the client."
          },
          "email": {
            "type": "string",
            "description": "The email of the client."
          },
          "weight": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The weight of the client in pounds, rounded to the nearest pound.",
            "format": "int32"
          },
          "height": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The height of the client in inches, rounded to the nearest inch.",
            "format": "int32"
          },
          "birthDate": {
            "type": "string",
            "description": "The date of birth of the client.",
            "format": "date-time"
          },
          "lastWorkout": {
            "type": [
              "null",
              "string"
            ],
            "description": "The date of the last workout of the client.",
            "format": "date"
          },
          "goal": {
            "$ref": "#/components/schemas/NullableOfTrainingGoal"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ],
            "description": "Notes about the client."
          }
        },
        "description": "Represents a client with personal information.",
        "example": {
          "id": 1,
          "firstName": "Jane",
          "lastName": "Smith",
          "email": "jane.smith@email.com",
          "weight": 60,
          "height": 170,
          "birthDate": "1990-01-01T00:00:00.0000000+00:00"
        }
      },
      "Level": {
        "enum": [
          "Junior",
          "Senior",
          "Elite"
        ],
        "description": "The level of the trainer."
      },
      "NullableOfTrainingGoal": {
        "enum": [
          "FatLoss",
          "MuscleGain",
          "Endurance",
          "Flexibility",
          "Strength",
          "GeneralHealth",
          null
        ],
        "description": "The training goal of the client."
      },
      "Trainer": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The unique identifier of the trainer, assigned by the system when the trainer is created.",
            "format": "int32"
          },
          "firstName": {
            "type": "string",
            "description": "The first name of the trainer."
          },
          "lastName": {
            "type": "string",
            "description": "The last name of the trainer."
          },
          "email": {
            "type": "string",
            "description": "The email address of the trainer."
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "isCertificationActive": {
            "type": "boolean",
            "description": "Indicates whether the trainer's certification is active."
          }
        },
        "example": {
          "id": 1,
          "firstName": "John",
          "lastName": "Doe",
          "email": "john.doe@email.com",
          "level": "Junior",
          "isCertificationActive": false
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Clients"
    },
    {
      "name": "Trainers"
    }
  ]
}